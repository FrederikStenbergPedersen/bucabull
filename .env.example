APP_NAME=Bucabull
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_DOMAIN=bucabull.com
HOME_TEAM_SLUG=bucabull

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_CLIENT_SECRET=
STEAM_REDIRECT_URI=http://localhost:8000/auth/steam/callback

# Faceit Developer Portal (free tier): https://developers.faceit.com
FACEIT_API_KEY=

# Roster-refresh scaling (see config/roster.php). Defaults are fine for a
# handful of teams; raise the batch size / lower the TTL as you grow, and
# keep FACEIT_MAX_REQUESTS_PER_RUN under your FACEIT plan's rate limit.
# ROSTER_ACTIVE_TEAM_DAYS=14
# ROSTER_STATS_BATCH_SIZE=40
# ROSTER_STATS_TTL_MINUTES=20
# ROSTER_FACEIT_MAX_REQUESTS_PER_RUN=250

# The demo parser binary (go/cmd/democompact) — defaults to where the
# Dockerfile's gobuild stage puts it in the production image
# (/usr/local/bin/democompact), which doesn't exist on a native local
# install. Build a local copy with Docker (no local Go toolchain needed):
#   docker run --rm -v "$(pwd)/go:/build" -w /build -e GOOS=windows -e GOARCH=amd64 golang:1.27-bookworm \
#     go build -o /build/democompact.exe ./cmd/democompact
# (drop the GOOS/GOARCH overrides on macOS/Linux, and the .exe suffix)
# then point this at it, e.g. DEMOS_PARSER_BINARY_PATH=go/democompact.exe
DEMOS_PARSER_BINARY_PATH=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bucabull
DB_USERNAME=bucabull
DB_PASSWORD=bucabull

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
